# Copy to .env and fill in to run the live Telegram bot.
# Obtain a token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optional: how often to re-check tracked prices, in seconds.
# Default is 1800 (30 minutes, like AviaGram). Lower it for quick demos.
AVIA_TRACK_INTERVAL_SECONDS=1800
